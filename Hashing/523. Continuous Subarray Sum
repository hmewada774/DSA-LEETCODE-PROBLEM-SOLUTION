class Solution {
public:
    bool checkSubarraySum(vector<int>& nums, int k) {
        
        unordered_map<long long, int> mp;

        long long sum = 0;

        mp[0] = -1;

        for(int i = 0; i < nums.size(); i++) {

            sum += nums[i];

            long long rem;

            if(k == 0)
                rem = sum;
            else
                rem = sum % k;

            if(mp.find(rem) != mp.end()) {

                if(i - mp[rem] >= 2)
                    return true;

            }
            else {
                mp[rem] = i;
            }
        }

        return false;
    }
};
