class Solution {
public:
    int majorityElement(vector<int>& nums) {
        unordered_map<int, int> count;
        int n = nums.size();
        int thereshold =  n/2;

        for(int i = 0; i< n; i++){
            count[nums[i]]++;
            if(count[nums[i]] > thereshold){
                return nums[i];
            }
        }
        return -1;
    }

};
