class Solution {
public:
    int maxSum(vector<int>& nums, int k) {
        const long long MOD = 1e9 + 7;
        vector<int> bits(31, 0);

        // Count set bits at each position
        for (int j = 0; j < nums.size(); j++) {
            int num = nums[j];

            for (int i = 0; i < 31; i++) {
                if (num & (1 << i)) {
                    bits[i]++;
                }
            }
        }

        long long ans = 0;

        // Construct the maximum possible number k times
        for (int j = 0; j < k; j++) {
            long long num = 0;

            for (int i = 0; i < 31; i++) {
                if (bits[i] > 0) {
                    num |= (1LL << i);
                    bits[i]--;
                }
            }

            ans = (ans + num * num) % MOD;
        }

        return ans;
    }
};
