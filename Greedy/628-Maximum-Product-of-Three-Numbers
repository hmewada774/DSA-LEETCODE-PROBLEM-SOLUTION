class Solution {
public:
    int maximumProduct(vector<int>& nums) {
        // sort(nums.begin(), nums.end());
        // int ans = 1;
        // int n = nums.size();
        // if(n< 3){
        //     return 0 ;
        // }
        // for(int i = n-3; i<n; i++){
        //     ans = ans*nums[i];
        // }
        // return ans;


        sort(nums.begin(), nums.end());

        int n = nums.size();

        int p1 = nums[n-1] * nums[n-2] * nums[n-3]; // three largest
        int p2 = nums[0] * nums[1] * nums[n-1];     // two smallest + largest

        return max(p1, p2);
    }
};
