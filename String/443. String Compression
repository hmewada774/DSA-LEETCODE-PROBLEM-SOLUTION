class Solution {
public:
    int characterReplacement(string s, int k) {
        int n = s.size();
        int left = 0;
        int right = 0;

        int ans = 0 ;
        int maxAns = 0;

        int freq[26] = {0};

        while(right < n){
            freq[s[right]-'A']++;

            maxAns = max(maxAns, freq[s[right]-'A']);

            if((right - left + 1) - maxAns > k){
                freq[s[left] - 'A']--;
                left++;

            }

            ans = max(ans, right - left +1);

            right ++;
        }

        return ans;
    }
};
