class Solution {
public:
    int compress(vector<char>& chars) {
        int n = chars.size();

        int read = 0;
        int write = 0;

        while(read < n){
            char current = chars[read];
            int count = 0;
            while(read < n && chars[read] == current){
                read++;
                count++;
            }

            chars[write] = current;
            write++;

            if(count > 1){
                string s =  to_string(count);
                for( int i = 0; i<s.size(); i++){
                    chars[write] = s[i];
                    write++;
                }
            }
            
        }

        return write;
    }
};
