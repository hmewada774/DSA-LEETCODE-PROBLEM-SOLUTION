class Solution {
public:
    int secondHighest(string s) {
        int n = s.size();
        int mexi = INT_MIN;
        int second = INT_MIN;

        for(int i = 0; i<n; i++){
            if(isdigit(s[i])){
                int num = s[i] - '0';

                if(num > mexi){
                    second = mexi;
                    mexi = num;
                }
                else if(num < mexi && num > second){
                    second = num;
                }
            }

        }
        if(second == INT_MIN){
            return -1;
        }
        return second;
    }
};
