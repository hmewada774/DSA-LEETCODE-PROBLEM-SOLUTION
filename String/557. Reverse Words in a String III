class Solution {
public:
    string reverseWords(string s) {
        int n = s.size();
        string ans = "";
       for(int i = 0; i<n;i++){
            string word = "";
            while(i<n && s[i] != ' '){
                word += s[i];
                i++;
            }
            reverse(word.begin(), word.end());
            if(word.length()>0){
                if(ans.length() >0){
                    ans += " ";
                }
                ans += word;
            }
        } 
        return ans;
    }
};
