class Solution {
public:
    int maxArea(vector<int>& height) {
        int n = height.size();

        int left = 0;
        int right = n-1;


        int mexiWater = 0;

        while(left < right){
            
            int width = right - left;
            int area = min(height[right], height[left]) * width;

            mexiWater = max(mexiWater, area);


            if(height[left]< height[right]){
                left++;
            }
            else{
                right--;
            }

        }

        return mexiWater;
    }
};
