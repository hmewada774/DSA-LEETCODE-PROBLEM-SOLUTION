class Solution {
public:
    string makeGood(string s) {
       string ans = "";
       int n = s.size();

       int i = 0;
       while(i < n){
        if(!ans.empty() && abs(ans.back() - s[i]) == 32){
            ans.pop_back();
        }
        else{
            ans.push_back(s[i]);
        }
        i++;
       } 
       return ans;
    }
};
