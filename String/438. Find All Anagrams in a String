class Solution {
public:
    vector<int> findAnagrams(string s, string p) {
        int n = s.size();
        int m = p.size();
        vector<int> ans;
        vector<int> fre1(26,0);
        vector<int> fre2(26,0);

        int i = 0;
        while(i<m){
            fre1[p[i]-'a']++;
            i++;
        }

        int left = 0;
        int right = 0;

        while(right <n){
            fre2[s[right] - 'a']++;

            if(right - left + 1 == m){
                if(fre1 == fre2){
                    ans.push_back(left);
                }
                fre2[s[left]-'a']--;
                left++;
            }
            right++;
        }
        return ans;

    }

};
