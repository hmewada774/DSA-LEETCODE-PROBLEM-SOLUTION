class Solution {
public:
    int findPeak(vector<int>& arr, int n) {

        int low = 0;
        int high = n - 1;

        while (low < high) {

            int mid = low + (high - low) / 2;

            if (arr[mid] < arr[mid + 1]) {
                low = mid + 1;
            }
            else {
                high = mid;
            }
        }

        return low;
    }

    int peakIndexInMountainArray(vector<int>& arr) {

        int n = arr.size();

        return findPeak(arr, n);
    }
};
