
class Solution {
public:
    int maximumSaleItems(vector<vector<int>>& items, int budget) {
        int n = items.size();
        int minPrice = INT_MAX;

        // Find minimum item price
        for (auto &item : items) {
            minPrice = min(minPrice, item[1]);
        }

        vector<int> dp(budget + 1, 0);

        for (auto &item : items) {
            int factor = item[0];
            int price = item[1];

            // Count free items obtained by buying this type
            int cnt = 0;

            for (auto &other : items) {
                if (other[0] % factor == 0) {
                    cnt++;
                }
            }

            // First purchase: one purchased item + free items
            for (int j = budget; j >= price; j--) {
                dp[j] = max(dp[j], dp[j - price] + cnt);
            }
        }

        // Use remaining budget to buy cheapest items
        int ans = 0;

        for (int i = 0; i <= budget; i++) {
            ans = max(ans, dp[i] + (budget - i) / minPrice);
        }

        return ans;
    }
};
