class Solution {
public:
    int pivotIndex(vector<int>& nums) {
        int n = nums.size();
        int leftSum = 0; 
        int totalSum = 0;

        for(int i = 0; i<n; i++){
            totalSum += nums[i];
        }

        //right sum = total sum - left sum - nums[i];
        // total sum = right sum+ left ssum + nums[i]

        int rightSum = 0;

        for(int i =0; i<n; i++){
            rightSum = totalSum - leftSum - nums[i];
            if(rightSum == leftSum){
                return i;
            }

            leftSum += nums[i];
        }

        return -1;
    }
};
