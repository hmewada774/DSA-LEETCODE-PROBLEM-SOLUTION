class Solution {
public:
    int maxProfit(vector<int>& prices) {
        int minPrice = INT_MIN;
        int maxProfit = 0;

        int n = prices.size();

        // for(int i = 1; i<n; i++){
        //     if(prices[i] > prices[i-1]){
        //         maxProfit += prices[i] - prices[i-1];
        //     }
        // }

        // return maxProfit;


        for(int i = 1; i<n; i++ ){
            int currProfit = prices[i] - prices[i-1];
            if(currProfit < 0){
                currProfit = 0;
            }

            maxProfit += max(0, prices[i]-prices[i-1]);
        }
        return maxProfit;
    }
};
