class Solution {
public:
    int findKthLargest(vector<int>& nums, int k) {
        int ans = INT_MIN;
        int n = nums.size();
        for(int i = 0; i<k; i++){
            int mxi = INT_MIN;
            int idx = -1;

            for(int j = 0; j<n; j++){
                if(nums[j] > mxi){
                    mxi = nums[j];
                    idx = j;
                }
            }
            ans = mxi;
            nums[idx] = INT_MIN;
        }
        return ans;
    }
};




class Solution {
public:
    int findKthLargest(vector<int>& nums, int k) {
        int n = nums.size();
        int target = n - k;

        int left = 0, right = n - 1;

        while (left <= right) {
            int pivot = nums[right];
            int i = left;

            for (int j = left; j < right; j++) {
                if (nums[j] <= pivot) {
                    swap(nums[i], nums[j]);
                    i++;
                }
            }

            swap(nums[i], nums[right]);

            if (i == target)
                return nums[i];

            else if (i < target)
                left = i + 1;

            else
                right = i - 1;
        }

        return -1;
    }
};

